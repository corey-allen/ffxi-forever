diff --git a/src/map/worldbots_hooks.h b/src/map/worldbots_hooks.h
new file mode 100644
index 0000000000..a37af68e81
--- /dev/null
+++ b/src/map/worldbots_hooks.h
@@ -0,0 +1,34 @@
+/*
+===========================================================================
+
+  FFXI-Forever world bots (github.com/corey-allen/ffxi-forever): core hook points.
+
+  The only coupling between the Phoenix core and modules/worldbots. The core sets `engine` and calls the optional
+  callbacks; the module fills them in at startup. Everything else lives in the module.
+  Applied by patches/phoenix-b48e2d4e/worldbots-core.patch.
+
+===========================================================================
+*/
+
+#pragma once
+
+#include <chrono>
+#include <functional>
+
+class MapEngine;
+class CBaseEntity;
+struct action_t;
+
+namespace worldbots
+{
+
+// Set by MapEngine's constructor: lets the module reach sessions and zones.
+inline MapEngine* engine = nullptr;
+
+// Every action broadcast (GP_SERV_COMMAND_BATTLE2): the bot AI learns outcomes (damage, skillchains, misses).
+inline std::function<void(const action_t&)> onActionResult;
+
+// A monster starts a TP move, with its real cast time: the bot AI times stuns and interrupts.
+inline std::function<void(CBaseEntity*, std::chrono::milliseconds)> onMobSkillStart;
+
+} // namespace worldbots
